# kit.env — parametri del kit. Copia questo file in kit.env (stessa cartella) e compila i valori.
# Lo leggono tutti gli script di scripts/: installa-strumenti.sh, installa-kit.sh, avvia-cloudcli.sh,
# nuovo-progetto.sh, sync-vault.sh, controllo-backup.sh. kit.env è in .gitignore (può contenere nomi e domini privati).

NOME="Marco"                        # nome dell'utente: compare nei messaggi degli hook e nel CLAUDE.md
GITHUB_USER="marco-rossi"           # account GitHub dell'utente: repo privati <GITHUB_USER>/<progetto> e <GITHUB_USER>/secrets-vault
DOMINIO="claude.esempio.it"         # dominio pubblico della CloudCLI (record DNS A → IP del server)
LIVELLO="principiante"              # principiante | esperto — cambia il tono del CLAUDE.md (tutor vs collega)
CAVEMAN="no"                        # si | no — modalità «caveman» (risposte ultra-brevi) attiva a ogni sessione; con un principiante lasciarla a no

HOME_UTENTE="/root"                 # home dell'utente Linux che fa girare Claude Code e CloudCLI
CLAUDE_DIR="$HOME_UTENTE/.claude"   # CLAUDE_CONFIG_DIR: skill, hook, settings, CLAUDE.md globale
SRV="$HOME_UTENTE/progetti"         # cartella dei progetti: una sottocartella per progetto (= un repo GitHub privato)
KIT_DIR="$HOME_UTENTE/kit-claude"   # dove sta questo kit sul server dell'utente

PORTA_CLOUDCLI="4444"               # porta locale della CloudCLI: ascolta solo su 127.0.0.1, la espone nginx con https
PORTA_ANTEPRIMA="3500"              # porta delle app in prova, raggiungibile da https://<DOMINIO>/anteprima/ con password

# Versioni (le stesse del server di Daniele al 17/11/2026; si aggiornano a mano, DISABLE_AUTOUPDATER=1)
NODE_V="22.23.4"
CLAUDE_V="2.1.319"
CLOUDCLI_V="1.37.7"
PM2_V="6.0.14"
NVM_V="v0.40.3"
