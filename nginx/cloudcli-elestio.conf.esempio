# Variante per un server Elestio (nginx OpenResty in docker con auto-ssl). Va in /opt/elestio/nginx/conf.d/<dominio>.conf.
# Il dominio va aggiunto alla regex ALLOWED_DOMAINS in /opt/elestio/nginx/.env (forma «nome[.]dominio[.]it»), poi:
#   docker exec elestio-nginx nginx -t && cd /opt/elestio/nginx && docker compose up -d     (un `docker restart` non rilegge l'env)
# Il certificato Let's Encrypt arriva al primo accesso https. $connection_upgrade è già definito dalla configurazione Elestio.
server {
    listen 443 ssl;
    http2 on;
    server_name __DOMINIO__;
    ssl_certificate_by_lua_block { auto_ssl:ssl_certificate() }
    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 200m;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /anteprima/ {
        auth_basic "Anteprima";
        auth_basic_user_file /etc/nginx/conf.d/anteprima.htpasswd;
        proxy_pass http://127.0.0.1:__PORTA_ANTEPRIMA__/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
    location / {
        proxy_pass http://127.0.0.1:__PORTA_CLOUDCLI__;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
